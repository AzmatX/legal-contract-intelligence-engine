# Environment variables for Contract Intelligence System

# Application Settings
APP_NAME=Contract Intelligence Engine
DEBUG=false
LOG_LEVEL=INFO

# OCR Settings
TESSERACT_PATH=/usr/bin/tesseract
POPPLER_PATH=/usr/bin

# NLP Settings
SPACY_MODEL=en_core_web_sm

# Risk Scoring Thresholds
RISK_LOW_THRESHOLD=30
RISK_HIGH_THRESHOLD=70

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# Data Paths
DATA_DIR=./data
SAMPLE_CONTRACTS_DIR=./data/sample_contracts
